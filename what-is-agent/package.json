{
  "name": "what-is-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "《Agent 是什么？从两份官方定义说起》· 8 镜概念短片 · Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3003",
    "presentation": "vite --config presentation/vite.config.ts",
    "voiceover": "vite --config voiceover/vite.config.ts",
    "render": "remotion render src/index.ts WhatIsAgent out/what-is-agent.mp4",
    "still": "remotion still src/index.ts WhatIsAgent out/preview.png",
    "typecheck": "tsc --noEmit",
    "typecheck:presentation": "tsc --noEmit -p presentation/tsconfig.json",
    "typecheck:voiceover": "tsc --noEmit -p voiceover/tsconfig.json",
    "captions": "tsx scripts/export-captions.ts",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.542",
    "remotion-voiceover": "file:vendor/remotion-voiceover-0.2.1.tgz"
  },
  "devDependencies": {
    "@remotion/player": "4.0.542",
    "@types/node": "22.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vite": "6.3.6"
  }
}
