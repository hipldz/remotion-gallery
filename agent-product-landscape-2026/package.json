{
  "name": "agent-production-timeline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "《回头看到 2026 年的 Agent 产品》· 39 镜 Remotion 源工程",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000",
    "preview": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && tsx scripts/check-voiceover.ts",
    "check:all": "npm run check && npm run build:preview && npm run test:voiceover",
    "build:preview": "vite build",
    "test:voiceover": "tsx scripts/test-voiceover.ts",
    "sync:storyboard": "node scripts/sync-storyboard.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:sync": "node scripts/sync-source.mjs && node scripts/import-assets.mjs",
    "captions": "tsx scripts/export-captions.ts",
    "format": "prettier . --write --ignore-path .prettierignore"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/player": "4.0.542",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.542",
    "remotion-voiceover": "file:vendor/remotion-voiceover-0.1.0.tgz",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vite": "6.3.6"
  }
}
